# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. .env 는 절대 GitHub에 올리지 않습니다.

# ── 화면(프런트엔드) ──
# 비워 두면 시연 모드, 중계 서버 주소를 넣으면 실제 AI 연결
VITE_API_BASE=

# ── 중계 서버 ──
PORT=8787
# none: 내 컴퓨터에서만 시험 / sso: 학교 통합인증 연결 후
AUTH_MODE=none
# 화면이 올라간 주소. 여러 개면 쉼표로 구분 (예: https://아이디.github.io)
ALLOWED_ORIGINS=http://localhost:5173

# 자동 선택일 때 쓸 공급사: gpt | claude | gemini
DEFAULT_PROVIDER=claude
MAX_REQUESTS_PER_DAY=200
MAX_OUTPUT_TOKENS=4000
# true: 주민번호·전화번호·등록번호를 가린 뒤 AI에 전달
MASK_PII=true

# ── API 키 (각 회사 콘솔에서 발급) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 실제 모델 이름 (각 회사 문서에서 최신 이름 확인 후 입력) ──
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
